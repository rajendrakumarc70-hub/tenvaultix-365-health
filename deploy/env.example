# Settings for the server. install.sh copies this to deploy/.env; edit that copy (nano .env).
# Never commit .env or send it to anyone: it holds the app's Microsoft secret and the database password.

# What runs on this server (comma-separated):
#   caddy  = the server has its own public IP (an Azure VM, or an office server with port forwarding)
#   tunnel = the server is behind a router and you use Cloudflare Tunnel (no ports opened)
#   db     = PostgreSQL in a container on this server (remove it if you use Azure Database for PostgreSQL)
COMPOSE_PROFILES=caddy,db

# The address customers will use, without https://  (for example health.tenvaultix.com)
TVX_DOMAIN=health.tenvaultix.com

# Only for the tunnel profile: the token from Cloudflare Zero Trust > Networks > Tunnels
TUNNEL_TOKEN=

# The Microsoft app registration (the same values as on Render)
TVX_CLIENT_ID=
TVX_CLIENT_SECRET=

# Signs people's sign-in cookies. install.sh fills this in with a random value; keep it secret.
TVX_SESSION_SECRET=
TVX_ENV=production

# The database. install.sh fills both in for the db container with a random password.
# Azure Database for PostgreSQL instead: remove "db" from COMPOSE_PROFILES and set
#   TVX_DATABASE_URL=postgresql://USER:PASSWORD@SERVER.postgres.database.azure.com:5432/tenvaultix?sslmode=require
# Leave TVX_DATABASE_URL empty for a single SQLite file (fine for a handful of customers).
POSTGRES_PASSWORD=
TVX_DATABASE_URL=

# Who can open the Tenvaultix console at /admin. After your first sign-in, /setup shows your account ID:
# put it in TVX_OPS_OBJECT_IDS so the console checks the account itself, not just its email.
TVX_OPS_EMAILS=
TVX_OPS_TENANT_ID=
TVX_OPS_OBJECT_IDS=

# Where "Ask Tenvaultix" and "Choose a plan" buttons go
TVX_CONTACT_EMAIL=
TVX_BOOKING_URL=

# Many customers: companies scanned at the same time, and how long reports are kept (each company's latest is
# always kept; 0 = forever). WEB_CONCURRENCY is the number of app processes.
# TVX_SCAN_WORKERS=4
# TVX_KEEP_REPORTS_DAYS=400
# WEB_CONCURRENCY=2

# Only with the tunnel profile, and only if /setup shows the wrong "Your address": read the visitor's address
# from Cloudflare's header. Never set this with Caddy: anyone could send that header straight to the server.
# TVX_CLIENT_IP_HEADER=CF-Connecting-IP

# Emergency stop from the server (for when the console itself is in doubt): uncomment, then run update.sh.
# Stops all scans, connections, one-click fixes and Azure reads. See docs/INCIDENT_RESPONSE.md.
# TVX_EMERGENCY_STOP=on
