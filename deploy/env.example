# Settings for the server. install.sh copies this to deploy/.env; edit that copy (nano .env).
# Never commit .env or send it to anyone: it holds the app's Microsoft secret.

# How the site is reached from the internet:
#   caddy  = the server has its own public IP (an Azure VM, or an office server with port forwarding)
#   tunnel = the server is behind a router and you use Cloudflare Tunnel (no ports opened)
COMPOSE_PROFILES=caddy

# The address customers will use, without https://  (for example health.tenvaultix.com)
TVX_DOMAIN=health.tenvaultix.com

# Only for COMPOSE_PROFILES=tunnel: the token from Cloudflare Zero Trust > Networks > Tunnels
TUNNEL_TOKEN=

# The Microsoft app registration (the same values as on Render)
TVX_CLIENT_ID=
TVX_CLIENT_SECRET=

# Signs people's sign-in cookies. install.sh fills this in with a random value; keep it secret.
TVX_SESSION_SECRET=
TVX_ENV=production

# Who can open the Tenvaultix console at /admin
TVX_OPS_EMAILS=
TVX_OPS_TENANT_ID=

# Where "Ask Tenvaultix" and "Choose a plan" buttons go
TVX_CONTACT_EMAIL=
TVX_BOOKING_URL=
