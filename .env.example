# Copy to .env (never commit it) or set these in Azure App Service > Configuration.

# Microsoft Entra app registration (multitenant) in the Tenvaultix tenant
TVX_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Certificate (recommended): path to the PEM private key + the certificate's thumbprint
TVX_CERT_PATH=/home/site/secrets/health-check.pem
TVX_CERT_THUMBPRINT=
# ...or a client secret instead of a certificate
TVX_CLIENT_SECRET=

# Public address of the site (must match the redirect URIs in the app registration)
TVX_BASE_URL=https://health.example.com

# Long random string for signing session cookies: python -c "import secrets; print(secrets.token_urlsafe(48))"
TVX_SESSION_SECRET=
TVX_ENV=production

# Where the database lives (Azure App Service: keep it under /home so it survives restarts)
TVX_DB_PATH=/home/data/health.db

# Where "Ask Tenvaultix to fix this" and "Choose a plan" buttons go (either or both)
TVX_CONTACT_EMAIL=
TVX_BOOKING_URL=
