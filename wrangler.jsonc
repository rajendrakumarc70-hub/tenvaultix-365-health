{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tenvaultix-365-health-dashboard",
	"main": "src/worker.ts",
	"compatibility_date": "2026-11-01",
	"observability": { "enabled": true },
	"containers": [
		{
			"class_name": "HealthApp",
			"image": "./Dockerfile",
			"max_instances": 1,
			"instance_type": "basic"
		}
	],
	"durable_objects": {
		"bindings": [{ "name": "HEALTH_APP", "class_name": "HealthApp" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["HealthApp"] }],
	// Public settings. Secrets (TVX_SESSION_SECRET, TVX_CLIENT_SECRET) are set with `wrangler secret put`.
	"vars": {
		"TVX_BASE_URL": "https://tenvaultix-365-health-dashboard.rajendrakumarc70.workers.dev",
		"TVX_CONTACT_EMAIL": "",
		"TVX_BOOKING_URL": ""
	}
}
